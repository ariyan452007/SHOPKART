# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/shopkart

# JSON Web Token (JWT) Configuration
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# HttpOnly Cookie Configuration
COOKIE_EXPIRES_DAYS=7
# strict for same-origin setups (local dev, Netlify /api proxy); none if the frontend calls the API cross-site
COOKIE_SAME_SITE=strict

# Razorpay Payment Gateway (TEST MODE keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Comma-separated frontend origins allowed by CORS in production
CLIENT_URLS=https://your-frontend.netlify.app

# Optional: failed login attempts allowed per email per 15 minutes (default 10)
# LOGIN_MAX_ATTEMPTS=10
